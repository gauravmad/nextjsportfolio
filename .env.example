# Copy to .env.local and fill in. NEVER put real values in this file: it is committed.
# Every variable is validated in src/lib/config/env.ts.

# ── Public (inlined into the browser bundle; never put a secret here) ─────────
# Canonical origin of the site. Used for metadataBase, OG tags, absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server only ───────────────────────────────────────────────────────────────
# Contact form delivery via AWS SES. SES_FROM_EMAIL must be a verified identity.
# If unset, the form logs messages in development and answers 503 in production.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
CONTACT_TO_EMAIL=

# "Ask me anything" chat, via OpenRouter's OpenAI-compatible API.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_API_KEY=
