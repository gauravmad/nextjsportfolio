# Copy to .env.local and fill in. Every variable is validated in src/lib/config/env.ts.

# ── Public (inlined into the browser bundle; never put a secret here) ─────────
# Canonical origin of the site. Used for metadataBase, OG tags, absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server only ───────────────────────────────────────────────────────────────
# Contact form delivery via Resend (https://resend.com). If these are unset, the
# form logs messages to the console in development and answers 503 in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend. The default only sends to your own account.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
